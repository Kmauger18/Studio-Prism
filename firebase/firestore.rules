rules_version = '2';

// Règles Firestore de Studio Prism.
//
// Principes :
//  - tout est refusé par défaut ;
//  - un utilisateur lit uniquement SON profil et ne peut pas modifier son rôle, son abonnement ni son statut ;
//  - seul un administrateur (role == 'admin' ET status == 'active' dans users/{uid}) peut lister les comptes
//    et modifier subscription / role / status des autres ;
//  - le rôle est lu dans Firestore (jamais dans un token ou un champ fourni par le navigateur) ;
//  - un administrateur ne peut pas modifier son propre rôle ni son propre statut (pas d'auto-verrouillage ni d'auto-promotion
//    par une session volée).
//
// Premier administrateur : à définir à la main dans la console Firebase (la console contourne ces règles). Voir README.md.
// Déploiement : firebase deploy --only firestore:rules   (ou copier-coller dans Console Firebase > Firestore > Règles).
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ utilitaires

    function isSignedIn() {
      return request.auth != null;
    }

    function isString(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function isEmail(v) {
      return isString(v, 3, 160) && v.matches('.+@.+[.].+');
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // Tranches « nombre de comptes nécessaires » (doivent rester identiques à SUBSCRIPTION_CONFIG dans js/app.js).
    function tierOk(range, lim) {
      return (range == '1'      && lim == 1)
          || (range == '2-10'   && lim == 10)
          || (range == '11-25'  && lim == 25)
          || (range == '26-50'  && lim == 50)
          || (range == '51-100' && lim == 100)
          || (range == '100+'   && lim == null);
    }

    // ------------------------------------------------------------ users/{uid}

    // Création : uniquement son propre document, avec des valeurs NON privilégiées imposées.
    function validIndividualProfile(d) {
      return d.accountKind == 'individual'
        && d.keys().hasOnly(['firstName', 'lastName', 'email', 'accountKind', 'subscription', 'role', 'status',
                             'createdAt', 'updatedAt', 'lastLogin', 'termsAcceptedAt']);
    }

    function validCompanyProfile(d) {
      return d.accountKind == 'company'
        && d.keys().hasAll(['companyId', 'companyName', 'companyEmail', 'companyUserRange', 'companyUserLimit'])
        && d.keys().hasOnly(['firstName', 'lastName', 'email', 'accountKind', 'subscription', 'role', 'status',
                             'createdAt', 'updatedAt', 'lastLogin', 'termsAcceptedAt',
                             'companyId', 'companyName', 'companyEmail', 'companyUserRange', 'companyUserLimit', 'jobTitle'])
        && isString(d.companyId, 1, 40)
        && isString(d.companyName, 1, 120)
        && isEmail(d.companyEmail)
        && tierOk(d.companyUserRange, d.companyUserLimit)
        && isString(d.get('jobTitle', ''), 0, 80);
    }

    function validNewUser() {
      let d = request.resource.data;
      return d.keys().hasAll(['firstName', 'lastName', 'email', 'accountKind', 'subscription', 'role', 'status',
                              'createdAt', 'updatedAt', 'lastLogin', 'termsAcceptedAt'])
        && isString(d.firstName, 1, 80)
        && isString(d.lastName, 1, 80)
        && isEmail(d.email)
        && d.email.lower() == request.auth.token.email.lower()
        && d.subscription == 'free'
        && d.role == 'user'
        && d.status == 'active'
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && d.lastLogin == request.time
        && d.termsAcceptedAt == request.time
        && (validIndividualProfile(d) || validCompanyProfile(d));
    }

    // Mise à jour par le propriétaire : uniquement la date de dernière connexion.
    function ownerUpdateOk() {
      return resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin'])
        && request.resource.data.lastLogin == request.time;
    }

    // Mise à jour par un administrateur : subscription / role / status (+ updatedAt), valeurs dans des listes fermées.
    function adminUpdateOk(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['subscription', 'role', 'status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.subscription in ['free', 'pro', 'pro_entreprise']
        && request.resource.data.role in ['user', 'admin']
        && request.resource.data.status in ['active', 'suspended']
        && (request.auth.uid != uid || changed.hasOnly(['subscription', 'updatedAt']));
    }

    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();                       // inclut les requêtes de comptage
      allow create: if isSignedIn() && request.auth.uid == uid && validNewUser();
      allow update: if isSignedIn() && (
                         (request.auth.uid == uid && ownerUpdateOk())
                         || (isAdmin() && adminUpdateOk(uid))
                       );
      allow delete: if false;                         // suppression : Admin SDK / console uniquement
    }

    // ------------------------------------------------------------ companies/{companyId}

    // Création : seulement pendant l'inscription (le profil créé dans le même lot doit référencer cette entreprise).
    function validNewCompany(companyId) {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'email', 'ownerUid', 'userRange', 'userLimit', 'subscription', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['name', 'email', 'ownerUid', 'userRange', 'userLimit', 'subscription', 'createdAt', 'updatedAt',
                             'phone', 'website'])
        && isString(d.name, 1, 120)
        && isEmail(d.email)
        && d.ownerUid == request.auth.uid
        && tierOk(d.userRange, d.userLimit)
        && d.subscription == 'free'
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && isString(d.get('phone', ''), 0, 40)
        && isString(d.get('website', ''), 0, 200)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == companyId;
    }

    match /companies/{companyId} {
      allow get: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && validNewCompany(companyId);
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscription', 'updatedAt'])
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.subscription in ['free', 'pro', 'pro_entreprise'];
      allow delete: if false;
    }

    // ------------------------------------------------------------ tout le reste : refusé

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
